  "bugs": { "url": "https://github.com/hexmillionaire/mcp-surface/issues" },
  "license": "MIT",
  "devDependencies": { "ajv": "8.20.0" },
  "keywords": ["mcp", "model-context-protocol", "mcp-server", "mcp-tools", "tools-list", "json-schema", "schema-diff", "breaking-changes", "compatibility", "contracts", "contract-testing", "lint", "ci", "cli", "offline"],
