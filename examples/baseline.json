{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Fetch a fictional record by key.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "key": {
            "maxLength": 100,
            "type": "string"
          },
          "limit": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "key"
        ],
        "type": "object"
      },
      "name": "fetch_record",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "count": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "enum": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "count"
        ],
        "type": "object"
      }
    }
  ]
}
